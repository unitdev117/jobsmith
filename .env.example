DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DATABASE_MIGRATION_URL=
# Host-owned and optional: only the host device runs this server; members connect to it.
VALKEY_URL=redis://127.0.0.1:6379
INVITE_TTL_MINUTES=5
LOG_LEVEL=warn

# Optional isolated integration-test services.
TEST_DATABASE_URL=
TEST_NAMESPACE=
TEST_VALKEY_URL=
